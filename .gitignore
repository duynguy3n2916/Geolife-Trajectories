# Những gì không đưa lên git. Nguyên tắc: không đưa dữ liệu, file sinh ra chạy lại được, file riêng của máy.
# Terraform có .gitignore riêng ở deploy/terraform/ (state, provider, email báo động).

# ---- Dữ liệu (lớn, tải riêng) ----
/data/

# ---- Kết quả sinh ra, chạy lại được ----
# đào sâu timestamp trùng (notebook 01), khoảng 43 MB
outputs/duplicates/
# hình xuất từ notebook để dán vào slide
reports/_fig_slide/
# store SQLite của API FastAPI cũ (tạo lại bằng archive/api_fastapi/build_store.py)
archive/api_fastapi/store/
# kết quả tạm của mlflow_track.py
results/
docs/

# ---- MLflow chạy trên máy (mlflow_track.py) ----
mlflow.db
mlruns/
mlartifacts/

# ---- deploy: log lần chạy, kết quả đo, gói tạm, địa chỉ API ----
deploy/batch/runs/
deploy/bench/
deploy/lookup/api_url.txt
*.tar.gz

# ---- Python ----
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Editor / OS ----
.vscode/
.idea/
Thumbs.db
.DS_Store
desktop.ini
