# Những gì không đưa lên git. Nguyên tắc: không đưa dữ liệu, file sinh ra chạy lại được, file riêng của máy.
# Terraform có .gitignore riêng ở deploy/terraform/ (state, provider, email báo động).

# ---- Dữ liệu (lớn, tải riêng) ----
/data/

# ---- Kết quả sinh ra, chạy lại được ----
# đào sâu timestamp trùng (notebook 01), khoảng 43 MB
outputs/duplicates/
# hình xuất từ notebook để dán vào slide
reports/_fig_slide/
docs/

# ---- deploy: log lần chạy, kết quả đo, gói tạm, địa chỉ API ----
batch/runs/
deploy/bench/
api/api_url.txt
api/cognito_client_id.txt
*.tar.gz

# ---- Python ----
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Editor / OS ----
.vscode/
.idea/
Thumbs.db
.DS_Store
desktop.ini

# ---- Tài liệu học và ghi chú làm việc riêng (chỉ trên máy) ----
deploy/terraform/HOC_TERRAFORM.md
notes/giai_thich_cp2.md
notes/ke_hoach_cp2.md
